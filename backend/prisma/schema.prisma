generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  portfolio  String
  status     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("clients")
}